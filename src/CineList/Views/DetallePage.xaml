<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CineList.Views.DetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CineList.ViewModels"
    xmlns:controles="clr-namespace:CineList.Controls"
    xmlns:helpers="clr-namespace:CineList.Helpers"
    x:DataType="vm:DetalleViewModel"
    Shell.NavBarIsVisible="False"
    Title="Detalle">

    <!-- Capas: fondo con el póster desenfocado, contenido y, encima, el póster que vuela desde la lista -->
    <Grid>

        <!-- Recortado: el desenfoque nativo se dibuja más allá de su borde -->
        <Grid
            x:Name="Fondo"
            HeightRequest="360"
            VerticalOptions="Start"
            InputTransparent="True"
            IsClippedToBounds="True"
            Opacity="0">
            <Grid x:Name="FondoArte" Opacity="0.35">
                <Image x:Name="FondoImagen" Aspect="AspectFill" />
            </Grid>
            <!-- Velo que funde el fondo con el color Fondo del tema (se pinta en código) -->
            <BoxView x:Name="FondoVelo" Color="Transparent" />
        </Grid>

        <Grid RowDefinitions="Auto,*">

            <!-- Encabezado propio: botón de volver -->
            <Grid Padding="16,12,16,4">
                <Button
                    FontFamily="Iconos"
                    Text="{x:Static helpers:Iconos.Atras}"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    CornerRadius="22"
                    HorizontalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CampoClaro}, Dark={StaticResource CampoOscuro}}"
                    BorderColor="{AppThemeBinding Light={StaticResource BordeCampoClaro}, Dark={StaticResource BordeCampoOscuro}}"
                    BorderWidth="1"
                    TextColor="{AppThemeBinding Light={StaticResource TextoClaro}, Dark={StaticResource TextoOscuro}}"
                    SemanticProperties.Description="Volver a la lista"
                    Command="{Binding VolverCommand}" />
            </Grid>

            <ScrollView x:Name="Desplazamiento" Grid.Row="1" Scrolled="OnDesplazado">
                <VerticalStackLayout Padding="24,8,24,32" Spacing="20">

                    <controles:PosterView
                        x:Name="Poster"
                        Pelicula="{Binding Pelicula}"
                        WidthRequest="220"
                        HeightRequest="320"
                        HorizontalOptions="Center"
                        Opacity="0" />

                    <VerticalStackLayout x:Name="BloqueTitulo" Spacing="6" Opacity="0">
                        <Label
                            Text="{Binding Genero}"
                            FontFamily="InterBold"
                            FontSize="11"
                            CharacterSpacing="1.2"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark={StaticResource AcentoOscuro}}" />
                        <Label
                            Text="{Binding Pelicula.Titulo}"
                            Style="{StaticResource TituloGrande}"
                            FontSize="28"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Label
                        x:Name="Meta"
                        Text="{Binding Meta}"
                        IsVisible="{Binding HayMeta}"
                        Style="{StaticResource TextoSecundario}"
                        HorizontalTextAlignment="Center"
                        Opacity="0" />

                    <VerticalStackLayout x:Name="BloqueEstado" Spacing="12" HorizontalOptions="Center" Opacity="0">
                        <controles:EstrellasView
                            x:Name="Estrellas"
                            Valor="{Binding Pelicula.Calificacion, FallbackValue=0}"
                            EsEditable="False"
                            Tamano="26"
                            HorizontalOptions="Center" />
                        <Border
                            x:Name="Etiqueta"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,5"
                            HorizontalOptions="Center">
                            <Label
                                x:Name="TextoEtiqueta"
                                Text="{Binding TextoEtiqueta}"
                                FontFamily="InterBold"
                                FontSize="12"
                                CharacterSpacing="0.8" />
                        </Border>
                    </VerticalStackLayout>

                    <Label
                        x:Name="Sinopsis"
                        Text="{Binding Sinopsis}"
                        FontSize="15"
                        LineHeight="1.45"
                        Opacity="0">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HaySinopsis}" Value="False">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSecundarioClaro}, Dark={StaticResource TextoSecundarioOscuro}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <VerticalStackLayout x:Name="Botones" Spacing="12" Opacity="0">
                        <Button
                            Text="{Binding TextoBotonVista}"
                            Style="{StaticResource BotonPrimario}"
                            IsEnabled="{Binding NoOcupado}"
                            Command="{Binding AlternarVistaCommand}" />
                        <Button
                            Text="Editar"
                            Style="{StaticResource BotonSecundario}"
                            IsEnabled="{Binding NoOcupado}"
                            Command="{Binding EditarCommand}" />
                        <Button
                            Text="Eliminar"
                            Style="{StaticResource BotonPeligro}"
                            IsEnabled="{Binding NoOcupado}"
                            Command="{Binding EliminarCommand}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <AbsoluteLayout x:Name="CapaVuelo" InputTransparent="True" CascadeInputTransparent="True">
            <controles:PosterView
                x:Name="PosterVuelo"
                Pelicula="{Binding Pelicula}"
                IsVisible="False" />
        </AbsoluteLayout>

    </Grid>
</ContentPage>
