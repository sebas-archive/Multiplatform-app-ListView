<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CineList.Views.PeliculasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CineList">

    <!-- Pagina provisional: la Tarea 6 reemplaza su contenido con la lista -->
    <Grid x:Name="Contenido" Padding="20,48,20,20" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="CineList" Style="{StaticResource TituloGrande}" VerticalOptions="Center" />
            <Button
                x:Name="BotonTema"
                Grid.Column="1"
                FontFamily="Iconos"
                FontSize="24"
                WidthRequest="48"
                HeightRequest="48"
                Padding="0"
                CornerRadius="24"
                BackgroundColor="{AppThemeBinding Light={StaticResource CampoClaro}, Dark={StaticResource CampoOscuro}}"
                BorderColor="{AppThemeBinding Light={StaticResource BordeCampoClaro}, Dark={StaticResource BordeCampoOscuro}}"
                BorderWidth="1"
                TextColor="{AppThemeBinding Light={StaticResource AcentoClaro}, Dark={StaticResource AcentoOscuro}}"
                AutomationId="BotonTema"
                SemanticProperties.Description="Cambiar entre modo claro y oscuro"
                Clicked="OnAlternarTema" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,24,0,0">
            <Label x:Name="Descripcion" Style="{StaticResource TextoSecundario}" />
            <Button Text="Acento" Style="{StaticResource BotonPrimario}" />
            <Button Text="Secundario" Style="{StaticResource BotonSecundario}" />
            <Button Text="Peligro" Style="{StaticResource BotonPeligro}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
