<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tokens de color: Oscuro = "Sala oscura", Claro = "Claro editorial" -->
    <Color x:Key="FondoOscuro">#0F1115</Color>
    <Color x:Key="FondoClaro">#F7F5F0</Color>
    <Color x:Key="SuperficieOscuro">#181B21</Color>
    <Color x:Key="SuperficieClaro">#FFFFFF</Color>
    <Color x:Key="BordeSuperficieOscuro">#181B21</Color>
    <Color x:Key="BordeSuperficieClaro">#ECE7DE</Color>
    <Color x:Key="CampoOscuro">#1C1F26</Color>
    <Color x:Key="CampoClaro">#FFFFFF</Color>
    <Color x:Key="BordeCampoOscuro">#1C1F26</Color>
    <Color x:Key="BordeCampoClaro">#E6E1D8</Color>
    <Color x:Key="TextoOscuro">#F2F2F2</Color>
    <Color x:Key="TextoClaro">#1D1B18</Color>
    <Color x:Key="TextoSecundarioOscuro">#8B929C</Color>
    <Color x:Key="TextoSecundarioClaro">#7A7368</Color>
    <Color x:Key="AcentoOscuro">#F5C518</Color>
    <Color x:Key="AcentoClaro">#B4532A</Color>
    <!-- Texto sobre el acento (botones, chips activos) -->
    <Color x:Key="AcentoTextoOscuro">#0F1115</Color>
    <Color x:Key="AcentoTextoClaro">#FFFFFF</Color>
    <Color x:Key="VistaTextoOscuro">#4CD964</Color>
    <Color x:Key="VistaTextoClaro">#2F6B2A</Color>
    <Color x:Key="VistaFondoOscuro">#264CD964</Color>
    <Color x:Key="VistaFondoClaro">#E5EFE3</Color>
    <Color x:Key="PendienteTextoOscuro">#FFB340</Color>
    <Color x:Key="PendienteTextoClaro">#A1531F</Color>
    <Color x:Key="PendienteFondoOscuro">#26FFB340</Color>
    <Color x:Key="PendienteFondoClaro">#F6E7D8</Color>
    <!-- Peligro (eliminar) -->
    <Color x:Key="PeligroOscuro">#FF6B5E</Color>
    <Color x:Key="PeligroClaro">#B3261E</Color>
</ResourceDictionary>
