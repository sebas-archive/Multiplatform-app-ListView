<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CineList.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CineList.Views"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    Title="CineList">

    <!-- Las rutas "detalle" y "formulario" se registran en AppShell.xaml.cs cuando existan sus páginas -->
    <ShellContent
        Title="Películas"
        ContentTemplate="{DataTemplate views:PeliculasPage}"
        Route="peliculas" />

</Shell>
