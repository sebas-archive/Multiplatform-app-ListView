@page "/"
@using CineList.Web.Services
@implements IDisposable
@inject TemaService Tema

<PageTitle>CineList</PageTitle>

<header class="cabecera">
    <h1 class="titulo-app">CineList</h1>
    <button class="boton-redondo" type="button" @onclick="Tema.AlternarAsync"
            aria-label="@(Tema.Oscuro ? "Cambiar a tema claro" : "Cambiar a tema oscuro")">
        <span class="icono" aria-hidden="true">@(Tema.Oscuro ? "" : "")</span>
    </button>
</header>

@code {
    protected override async Task OnInitializedAsync()
    {
        Tema.Cambio += Redibujar;
        await Tema.InicializarAsync();
    }

    private void Redibujar() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tema.Cambio -= Redibujar;
}
